#!/usr/bin/env bash
# Guarda de pre-push: a branch de integracao sobe PRIMEIRO.
#
# POR QUE ESTE ARQUIVO EXISTE
# ---------------------------
# O fluxo correto e, nesta ordem:
#
#   1. git push origin dev
#   2. git checkout main && git merge --ff-only dev
#   3. git push origin main
#
# Quando o passo 1 e pulado, a `dev` do GitHub fica atras da branch de
# producao, e tudo que for commitado na `dev` depois disso fica preso na
# maquina, sem aviso nenhum. Esse mesmo gate existe nos outros repositorios
# deste autor porque a regra escrita ja falhou, medido, em mais de um deles:
# a `dev` do GitHub ficou dias/semanas atras da `main` sem que ninguem
# percebesse ate revisar o historico remoto.
#
# A regra escrita ja existia e falhou, entao aqui ela deixa de depender de
# memoria: este hook recusa o push da branch de producao enquanto a branch de
# integracao local estiver a frente da do remoto.
#
# ATIVACAO: `git config core.hooksPath .githooks`.
#
# ESCAPE: `git push --no-verify`.
set -euo pipefail

BRANCH_PRODUCAO="main"
BRANCH_INTEGRACAO="dev"

# O git manda as refs do push por stdin, uma linha por ref. Precisamos drenar
# stdin de qualquer jeito para nao gerar SIGPIPE, entao capturamos.
refs_do_push="$(cat || true)"

# Repositorio sem branch de integracao: nada a garantir.
if ! git rev-parse --verify --quiet "refs/heads/${BRANCH_INTEGRACAO}" >/dev/null; then
    exit 0
fi

promove=0
integracao_no_mesmo_push=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -n "${remote_ref:-}" ] || continue

    # local_sha so com zeros = delecao de ref. Nao leva codigo, nao promove.
    case "${local_sha:-}" in
        *[!0]*) ;;
        *) continue ;;
    esac

    alvo="${remote_ref#refs/heads/}"
    if [ "$alvo" = "$BRANCH_PRODUCAO" ]; then
        promove=1
    fi
    if [ "$alvo" = "$BRANCH_INTEGRACAO" ]; then
        integracao_no_mesmo_push=1
    fi
done <<< "$refs_do_push"

# Push que nao toca a branch de producao nao e promocao.
if [ "$promove" -eq 0 ]; then
    exit 0
fi

# `git push origin dev main` leva as duas no mesmo comando, e o git envia a
# `dev` antes. A ordem esta garantida, entao nao ha o que barrar.
if [ "$integracao_no_mesmo_push" -eq 1 ]; then
    exit 0
fi

# Sem ref de rastreio nao da para comparar. Avisa e libera: gate que barra por
# falta de informacao ensina a usar --no-verify por reflexo.
if ! git rev-parse --verify --quiet "refs/remotes/origin/${BRANCH_INTEGRACAO}" >/dev/null; then
    echo "[gate] aviso: nao existe refs/remotes/origin/${BRANCH_INTEGRACAO} aqui." >&2
    echo "[gate] rode 'git fetch origin' para a guarda poder comparar. Push liberado." >&2
    exit 0
fi

a_frente="$(git rev-list --count "origin/${BRANCH_INTEGRACAO}..${BRANCH_INTEGRACAO}")"

if [ "$a_frente" -gt 0 ]; then
    echo "" >&2
    echo "[gate] push da '${BRANCH_PRODUCAO}' BARRADO." >&2
    echo "[gate]" >&2
    echo "[gate] a '${BRANCH_INTEGRACAO}' local esta ${a_frente} commit(s) a frente da" >&2
    echo "[gate] 'origin/${BRANCH_INTEGRACAO}'. Promover agora deixa a branch de" >&2
    echo "[gate] integracao do GitHub para tras, e o que estiver so nela fica preso" >&2
    echo "[gate] nesta maquina." >&2
    echo "[gate]" >&2
    git log --oneline "origin/${BRANCH_INTEGRACAO}..${BRANCH_INTEGRACAO}" 2>/dev/null \
        | sed 's/^/[gate]   /' >&2
    echo "[gate]" >&2
    echo "[gate] A ordem correta e:" >&2
    echo "[gate]   1. git push origin ${BRANCH_INTEGRACAO}" >&2
    echo "[gate]   2. git checkout ${BRANCH_PRODUCAO} && git merge --ff-only ${BRANCH_INTEGRACAO}" >&2
    echo "[gate]   3. git push origin ${BRANCH_PRODUCAO}" >&2
    echo "[gate]" >&2
    echo "[gate] Se a divergencia for esperada: git push --no-verify" >&2
    exit 1
fi

exit 0
